    local rf = net:FindFirstChild("RF/AdminService/SpawnBrainrotInBase")
    if not rf then setStatus("✕ RF not found!",true); return end

    setStatus("↑ Spawning "..selectedAnimal.." ×"..count.."...",false)
    task.spawn(function()
        for i=1,count do
