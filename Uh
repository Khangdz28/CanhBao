local function makeSearch(parent,yPos,ph)
    local wrap=newFrame({Size=UDim2.new(1,0,0,isMobile and 22 or 26),Position=UDim2.new(0,0,0,yPos),BackgroundColor3=C.inputBg,BorderSizePixel=0,ZIndex=4},parent)
    corner(6,wrap); stroke(C.border,1,wrap)
    local box=Instance.new("TextBox")
    box.PlaceholderText=ph; box.PlaceholderColor3=C.txtDim; box.Text=""
    box.Font=Enum.Font.Gotham; box.TextSize=isMobile and 10 or 11
    box.TextColor3=C.txt; box.BackgroundTransparency=1; box.BorderSizePixel=0
    box.ClearTextOnFocus=false; box.Size=UDim2.new(1,0,1,0); box.ZIndex=5; box.Parent=wrap
    pad(0,0,6,0,box)
    box.Focused:Connect(function() tween(wrap,TI_FAST,{BackgroundColor3=C.inputBg:Lerp(C.accent,0.08)}); stroke(C.accent,1,wrap) end)
    box.FocusLost:Connect(function() tween(wrap,TI_FAST,{BackgroundColor3=C.inputBg}); stroke(C.border,1,wrap) end)
    return box
end

local function makeScroll(parent,yPos,height)
    local wrap=newFrame({Size=UDim2.new(1,0,0,height),Position=UDim2.new(0,0,0,yPos),BackgroundColor3=C.item,BorderSizePixel=0,ZIndex=3},parent)
    corner(7,wrap); stroke(C.border,1,wrap)
    local sf=Instance.new("ScrollingFrame")
    sf.Size=UDim2.new(1,0,1,0); sf.BackgroundTransparency=1; sf.BorderSizePixel=0
    sf.ScrollBarThickness=3; sf.ScrollBarImageColor3=C.accent
    sf.CanvasSize=UDim2.new(0,0,0,0); sf.AutomaticCanvasSize=Enum.AutomaticSize.Y
    sf.ZIndex=4; sf.Parent=wrap
    local layout=Instance.new("UIListLayout"); layout.Padding=UDim.new(0,2); layout.Parent=sf
    pad(3,3,3,3,sf)
    return sf
end

local function makeItem(text,selected,parent,onClk)
    local b=newBtn({
        Text=text,Font=Enum.Font.Gotham,TextSize=isMobile and 10 or 11,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextColor3=selected and C.txtGreen or C.txt,
        BackgroundColor3=selected and C.itemSel or Color3.fromRGB(0,0,0),
        BackgroundTransparency=selected and 0 or 0.6,
        Size=UDim2.new(1,0,0,ITEM_H),ZIndex=5,AutoButtonColor=false,
    },parent)
    corner(5,b); pad(0,0,7,0,b)
    if selected then stroke(C.accent,1,b) end
    b.MouseEnter:Connect(function() if not selected then tween(b,TI_FAST,{BackgroundTransparency=0.3,BackgroundColor3=C.itemHov}) end end)
    b.MouseLeave:Connect(function() if not selected then tween(b,TI_FAST,{BackgroundTransparency=0.6,BackgroundColor3=Color3.fromRGB(0,0,0)}) end end)
    b.MouseButton1Click:Connect(onClk)
    return b
end

